# Copie este arquivo para .env e ajuste o endereço da API (SOA/FastAPI ou C#/.NET).
# Use o IP da sua máquina na rede (não use "localhost" no celular físico).
# O app adiciona "/api" automaticamente. Ex.: http://192.168.0.10:8000
# Se ficar vazio ou a API estiver fora do ar, o app usa os dados de demonstração (mock).
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000

# Tempo máximo de espera de cada requisição, em milissegundos.
EXPO_PUBLIC_API_TIMEOUT_MS=5000
